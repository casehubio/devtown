{
  "name": "devtown",
  "url": "https://github.com/casehubio/devtown",
  "hook_attributes": {
    "url": "https://REPLACE_WITH_YOUR_DOMAIN/api/github/webhook",
    "active": true
  },
  "redirect_url": "https://REPLACE_WITH_YOUR_DOMAIN/api/github/app/callback",
  "public": false,
  "default_permissions": {
    "pull_requests": "write",
    "checks": "write",
    "contents": "read",
    "metadata": "read"
  },
  "default_events": [
    "pull_request",
    "pull_request_review",
    "check_suite",
    "check_run"
  ]
}
